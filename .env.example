NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WalletConnect Cloud project ID (required for WalletConnect via RainbowKit)
# Get one free at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

ADMIN_EMAILS=you@example.com

DATABASE_URL=postgresql://user:password@host/dbname

# Email (Resend) — used for email verification and notifications
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Kwizerana Collab <onboarding@resend.dev>"

TWITTERAPI_IO_API_KEY=your-twitterapi-io-key
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io
TWITTERAPI_IO_USER_LOOKUP_PATH=/twitter/user/info

XFLUX_API_KEY=xflux_your-api-key
XFLUX_BASE_URL=https://www.xfluxapi.com/api/v1
XFLUX_USER_LOOKUP_PATH=/users/:username
